{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "description": "A group-chat agent that takes a thread from \"what should we get?\" to a completed purchase.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:live": "tsx scripts/simulate.ts --interactive",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
